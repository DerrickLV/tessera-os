# Never commit real secrets.
OPENAI_API_KEY=
# Read by config/models.yaml's ${VAR:-default} placeholders via settings.py.
TESSERA_MODEL_DEFAULT=gpt-5.6-terra
TESSERA_MODEL_HIGH_REASONING=gpt-5.6-sol
# Enforced by the central runtime policy gateway: test, sandbox, pilot, or production.
TESSERA_ENV=sandbox
# Read by cli.py to configure the standard library logging level.
TESSERA_LOG_LEVEL=INFO
TESSERA_OIDC_ISSUER=
TESSERA_OIDC_AUDIENCE=
TESSERA_OIDC_ALGORITHM=RS256
TESSERA_OIDC_VERIFICATION_KEY=

# Microsoft 365 read-only pilot. Leave disabled until the Entra app and exact
# SharePoint resource mapping have been approved. Never commit populated values.
TESSERA_M365_ENABLED=false
TESSERA_M365_TENANT_ID=
TESSERA_M365_CLIENT_ID=
TESSERA_M365_CLIENT_SECRET=
TESSERA_M365_CACHE_KEY=
TESSERA_M365_REDIRECT_URI=http://127.0.0.1:8000/v1/integrations/microsoft/callback
# One-line JSON, project id -> approved SharePoint resource. "zone" is the Tessera
# trust boundary: "internal" (01, partners only), "engagement" (02, walled to one
# named client), or "collaborator" (03, scoped to a purpose). An omitted zone
# defaults to "internal", which is the most restrictive — a mapping that forgets
# to declare its zone fails closed rather than open. Engagement and collaborator
# zones must name their client or engagement.
# {"internal-pilot":{"site_id":"...","drive_id":"...","folder_item_id":"root","zone":"internal"},
#  "acme":{"site_id":"...","drive_id":"...","zone":"engagement","client_id":"client-acme"}}
TESSERA_M365_PROJECT_RESOURCES={}

# One-line JSON, Entra security-group object ID -> Tessera group id. This is the
# only way a privileged group enters a production portal session. tessera_partner
# gates zone-01 reads; qualified_counsel is reserved for a later production review API.
# An unmapped Entra group grants nothing, and an absent groups claim (Entra's
# groups-overage case) resolves to no privileged groups rather than to an error.
# {"9f3c...-c0de":"qualified_counsel","1ab2...-50a5":"tessera_partner"}
TESSERA_M365_GROUP_MAP={}

# Named-user private portal deployment. Render supplies these as secrets/settings;
# do not populate or commit them locally with real account or project data.
TESSERA_APP_URL=https://app.tesseraag.com
TESSERA_API_URL=https://api.tesseraag.com
TESSERA_SESSION_SECRET=
TESSERA_ALLOWED_USER_IDS=
# One-line JSON, invited Entra object ID -> exact Tessera project IDs.
# {"user-object-id-1":["internal-pilot"],"user-object-id-2":["internal-pilot"]}
TESSERA_USER_PROJECTS={}
TESSERA_PROJECT_CATALOG={}
TESSERA_PORTAL_DATA_DIR=/var/data/tessera
